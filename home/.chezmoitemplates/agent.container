{{- $data := get .agents .name -}}
{{- $basedir := printf "%s/%s"  .agents.dir .name  -}}
# Generated by chezmoi from .chezmoitemplates/agent.container. Edit it there.

[Unit]
Description=Agent environment {{ .name }}: T3 Code server
StartLimitIntervalSec=0

[Container]
ContainerName=agent-{{ .name }}
Image=quay.io/davidagardh/agent-box:latest
AutoUpdate=registry
# network and user namespace comes from pod
Pod=agent-{{ .name }}.pod
# A small init as PID 1 passes stop signals on to T3 and reaps processes.
RunInit=true
# Mount your home directories without relabelling them.
# Also needed for nested podman.
SecurityLabelDisable=true
AddDevice=/dev/fuse
# Needed for nested podman networking
Sysctl=net.ipv4.ip_forward=1
AddDevice=/dev/net/tun
AddCapability=SETUID SETGID
Unmask=/proc/sys
Environment=T3CODE_HOST=::
Environment=T3CODE_PORT=3773
Environment=T3CODE_HOME={{ .agents.dir }}/{{ .name }}/t3

# HOME for the agent. Holds config and secrets.
Volume={{ $basedir }}/home:/home/agent
# T3 home. Should be same path as on host.
Volume={{ $basedir }}/t3:{{ .agents.dir }}/{{ .name }}/t3
# Git repos. Should be same path as on host.
Volume={{ $data.workdir }}:{{ $data.workdir }}
# Data for nested containers can be controlled or wiped separately.
Volume=agent-{{ .name }}:/home/agent/.local/share/containers

HealthCmd=curl -sS -o /dev/null http://localhost:3773/
HealthInterval=1m
HealthStartPeriod=2m
Notify=healthy

[Service]
# Ensure mounted directories exist and have correct permissions
ExecStartPre=/usr/bin/install -d -m 0700 {{ $basedir }} {{ $basedir }}/home {{ $basedir }}/t3
ExecStartPre=/usr/bin/install -d -m 0755 {{ $basedir }}/home/.local/share
ExecStartPre=/usr/bin/mkdir -p {{ $data.workdir }}
Restart=always
RestartSec=15
# The first start pulls a multi-gigabyte image.
TimeoutStartSec=900
# Agents yield to whatever you are doing on the desktop.
CPUWeight=50
IOWeight=50

[Install]
WantedBy=default.target
